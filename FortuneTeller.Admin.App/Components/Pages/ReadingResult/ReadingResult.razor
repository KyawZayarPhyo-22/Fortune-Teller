@code {
    private ReadingResponseModel? Result;
    private bool ShowEndModal = false;

    protected override void OnInitialized()
    {
        Result = State.CurrentResult;

        if (Result?.ReadingType == ReadingType.Tarot && Result.TarotSteps == null && Result.SelectedCards.Count > 0)
        {
            Result.TarotSteps = new TarotStepDataModel
            {
                TopicTitle = GetBurmeseTopicName(Result.Topic),
                CurrentSituation = !string.IsNullOrWhiteSpace(Result.DetailedInterpretation) ? Result.DetailedInterpretation : "လက်ရှိအချိန်တွင် ကံကြမ္မာစွမ်းအင်များ အလှည့်အပြောင်းသစ်တစ်ခု စတင်နေပြီ ဖြစ်ပါသည်။",
                FuturePotential = !string.IsNullOrWhiteSpace(Result.CoreProphecy) ? Result.CoreProphecy : "ရှေ့ဆက်၍ ကြိုးပမ်းအားထုတ်မှုနှင့်အတူ အခွင့်အလမ်းကောင်းများ ပေါ်ပေါက်လာပါမည်။",
                CautionaryAdvice = !string.IsNullOrWhiteSpace(Result.OpportunitiesAndChallenges) ? Result.OpportunitiesAndChallenges : "မဆင်မခြင် ဆုံးဖြတ်ခြင်းနှင့် စိတ်မရှည်ခြင်းများကို သတိပြုဆင်ခြင်ပါ။",
                ActionableGuidance = !string.IsNullOrWhiteSpace(Result.CosmicAdvice) ? Result.CosmicAdvice : "စိတ်ကို တည်ငြိမ်စွာထားပြီး အပြုသဘောဆောင်သော ပန်းတိုင်များဆီသို့ လျှောက်လှမ်းပါ။"
            };

            for (int i = 0; i < Result.SelectedCards.Count; i++)
            {
                var c = Result.SelectedCards[i];
                Result.TarotSteps.CardDetails.Add(new TarotStep2CardDetail
                {
                    CardNameEn = c.Card.Name,
                    CardNameMy = !string.IsNullOrEmpty(c.Card.BurmeseName) ? c.Card.BurmeseName : c.Card.Name,
                    RomanNumeral = c.Card.RomanNumeral,
                    ImageUrl = !string.IsNullOrEmpty(c.Card.ImageUrl) ? c.Card.ImageUrl : $"/images/tarot/m{c.Card.Id:D2}.jpg",
                    PositionName = c.PositionName,
                    IsReversed = c.IsReversed,
                    PositiveMeaning = !string.IsNullOrWhiteSpace(c.Card.UprightMeaning) ? c.Card.UprightMeaning : "အပြုသဘောဆောင်သော စွမ်းအင်များနှင့် ကောင်းမွန်သော လမ်းပွင့်လန်းမှုများ ရှိနေပါသည်။",
                    CautionaryMeaning = !string.IsNullOrWhiteSpace(c.Card.ReversedMeaning) ? c.Card.ReversedMeaning : "အလျင်စလို ဆုံးဖြတ်ခြင်းနှင့် စိတ်မရှည်ခြင်းများကို သတိပြုဆင်ခြင်ရန် လိုအပ်ပါသည်။"
                });

                Result.TarotSteps.PositionSyntheses.Add(new TarotStep3PositionSynthesis
                {
                    PositionIndex = i + 1,
                    PositionName = c.PositionName,
                    CardName = $"{c.Card.Name} ({c.Card.BurmeseName}){(c.IsReversed ? " - ပြောင်းပြန်" : " - အဖြောင့်")}",
                    SynthesisText = $"{c.PositionName} နေရာတွင် ကျရောက်နေပြီး {c.RevealedMeaning}"
                });
            }
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && Result?.ReadingType == ReadingType.Palm && string.IsNullOrEmpty(State.PalmImageBase64))
        {
            try
            {
                var cached = await JS.InvokeAsync<string?>("sessionStorage.getItem", "fortune_captured_palm");
                if (!string.IsNullOrEmpty(cached))
                {
                    State.PalmImageBase64 = cached;
                    StateHasChanged();
                }
            }
            catch { }
        }
    }

    private async Task StartNewReading()
    {
        try { await JS.InvokeVoidAsync("fortuneCamera.clearPalmCache"); } catch { }
        State.Reset();
        Nav.NavigateTo("choose-reading");
    }

    private async Task ExitToHome()
    {
        try { await JS.InvokeVoidAsync("fortuneCamera.clearPalmCache"); } catch { }
        State.Reset();
        Nav.NavigateTo("");
    }

    private void EndSession()
    {
        ShowEndModal = true;
    }

    private string GetBurmeseTopicName(ReadingTopic topic) => topic switch
    {
        ReadingTopic.Love => "အချစ်ရေး",
        ReadingTopic.CareerBusiness => "အလုပ်နှင့် စီးပွားရေး",
        ReadingTopic.Finance => "ငွေကြေးစီမံမှု",
        ReadingTopic.Education => "ပညာရေး",
        ReadingTopic.PersonalGrowth => "ကိုယ်ရည်ကိုယ်သွေး",
        ReadingTopic.Relationship => "ဆက်ဆံရေး",
        ReadingTopic.General => "အထွေထွေ",
        _ => "အထွေထွေ"
    };
}
