@page "/palm-permission"
@inject NavigationManager Nav
@inject FortuneStateService State
@inject IJSRuntime JS

<div class="container py-4 max-w-850 mx-auto">
    <!-- Neumorphic Stepper -->
    <div class="neu-stepper">
        <div class="neu-step-item completed">
            <div class="neu-step-bubble"><i class="bi bi-check2"></i></div>
            <span>အမျိုးအစား</span>
        </div>
        <div class="neu-step-divider"></div>
        <div class="neu-step-item active">
            <div class="neu-step-bubble">2</div>
            <span>လုံခြုံရေးနှင့် သဘောတူညီချက်</span>
        </div>
        <div class="neu-step-divider"></div>
        <div class="neu-step-item">
            <div class="neu-step-bubble">3</div>
            <span>ဓာတ်ပုံရိုက်မည်</span>
        </div>
        <div class="neu-step-divider"></div>
        <div class="neu-step-item">
            <div class="neu-step-bubble">4</div>
            <span>ကဏ္ဍရွေးမည်</span>
        </div>
    </div>

    <div class="neu-card p-4 p-md-5">
        <div class="text-center mb-4">
            <div class="neu-icon-socket mb-3" style="width: 72px; height: 72px; font-size: 2.2rem; color: var(--neu-teal);">
                <i class="bi bi-shield-check"></i>
            </div>
            <h2 class="font-display fw-extrabold text-neu-primary display-5 mb-2">လက်ဝါးဓာတ်ပုံ လုံခြုံရေးဆိုင်ရာ အချက်အလက်များ</h2>
            <p class="font-body text-neu-muted max-w-600 mx-auto">
                လက်ဝါးဓာတ်ပုံ မရိုက်ကူးမီ လုံခြုံစိတ်ချရမှု အာမခံချက်များကို ဖတ်ရှုပေးပါ။
            </p>
        </div>

        <div class="row g-4 my-2">
            <div class="col-md-6">
                <div class="neu-well p-4 h-100">
                    <h5 class="font-display fw-bold text-neu-teal mb-2">
                        <i class="bi bi-memory me-2"></i>ယာယီ Memory တွင်သာ အသုံးပြုခြင်း
                    </h5>
                    <p class="font-body small text-neu-muted mb-0" style="line-height: 1.6;">
                        သင်၏ လက်ဝါးဓာတ်ပုံကို ခေတ္တယာယီ RAM တွင်သာ ခွဲခြမ်းစိတ်ဖြာပြီး ချက်ချင်းဖျက်ပစ်ပါသည်။ မည်သည့် database သို့မဟုတ် disk ပေါ်တွင်မှ သိမ်းဆည်းထားခြင်း မရှိပါ။
                    </p>
                </div>
            </div>

            <div class="col-md-6">
                <div class="neu-well p-4 h-100">
                    <h5 class="font-display fw-bold text-neu-teal mb-2">
                        <i class="bi bi-speedometer2 me-2"></i>လုံခြုံရေး ကန့်သတ်ချက်များ
                    </h5>
                    <p class="font-body small text-neu-muted mb-0" style="line-height: 1.6;">
                        စနစ်လုံခြုံမှုအတွက် ဖိုင်ဆိုဒ် 5 MB ကန့်သတ်ချက်နှင့် အလိုအလျောက် စိစစ်မှုများ ထည့်သွင်းထားပါသည်။
                    </p>
                </div>
            </div>

            <div class="col-md-6">
                <div class="neu-well p-4 h-100">
                    <h5 class="font-display fw-bold text-neu-primary mb-2">
                        <i class="bi bi-fingerprint me-2"></i>ကိုယ်ရေးအချက်အလက် မသိမ်းဆည်းခြင်း
                    </h5>
                    <p class="font-body small text-neu-muted mb-0" style="line-height: 1.6;">
                        ဗေဒင်ဟောကြားရန်အတွက် လက်ဝါးလမ်းကြောင်းများ (နှလုံး၊ ဦးခေါင်း၊ အသက်၊ ကံကြမ္မာ) ကိုသာ အသုံးပြုပါသည်။
                    </p>
                </div>
            </div>

            <div class="col-md-6">
                <div class="neu-well p-4 h-100">
                    <h5 class="font-display fw-bold text-neu-primary mb-2">
                        <i class="bi bi-lightbulb me-2"></i>အကောင်းဆုံး ရိုက်ကူးနည်း
                    </h5>
                    <p class="font-body small text-neu-muted mb-0" style="line-height: 1.6;">
                        လက်ဝါးကို သဘာဝအလင်းရောင်တွင် ဖြန့်ပြထားပေးပါက လမ်းကြောင်းများကို အတိကျဆုံး ဖတ်ရှုနိုင်ပါမည်။
                    </p>
                </div>
            </div>
        </div>

        <!-- Tactile Consent Checkbox -->
        <div class="neu-well-deep p-4 my-4" @onclick="ToggleConsent" style="cursor: pointer;">
            <div class="neu-checkbox-wrapper">
                <div class="neu-checkbox-box @(UserConsent ? "checked" : "")">
                    @if (UserConsent)
                    {
                        <i class="bi bi-check-lg fw-bold"></i>
                    }
                </div>
                <div class="font-display text-neu-primary small fw-semibold">
                    ဤဗေဒင်ဟောကြားမှုအတွက် ကျွန်ုပ်၏ လက်ဝါးဓာတ်ပုံကို ခေတ္တယာယီအသုံးပြုရန် သဘောတူပါသည်။
                </div>
            </div>
        </div>

        @if (!string.IsNullOrEmpty(ErrorMessage))
        {
            <div class="neu-well p-3 text-danger font-display small mb-3">
                <i class="bi bi-exclamation-circle me-2"></i>@ErrorMessage
            </div>
        }

        <!-- Actions -->
        <div class="d-flex justify-content-between align-items-center mt-4">
            <a href="choose-reading" class="btn-neu">
                <i class="bi bi-arrow-left"></i> ဗေဒင်ပုံစံ ပြန်ရွေးမည်
            </a>
            <button class="btn-neu-teal px-4 py-2" @onclick="ProceedToCapture">
                သဘောတူပါသည် · ရှေ့သို့ <i class="bi bi-arrow-right"></i>
            </button>
        </div>
    </div>
</div>

@code {
    private bool UserConsent = false;
    private string? ErrorMessage;

    protected override void OnInitialized()
    {
        State.UserConsentGiven = true;
        Nav.NavigateTo("palm-capture", replace: true);
    }

    private void ToggleConsent()
    {
        UserConsent = !UserConsent;
        if (UserConsent) ErrorMessage = null;
    }

    private void ProceedToCapture()
    {
        if (!UserConsent)
        {
            ErrorMessage = "You must grant permission before proceeding to palm analysis.";
            return;
        }

        State.UserConsentGiven = true;
        Nav.NavigateTo("palm-capture");
    }
}
