@page "/palm-capture"
@inject NavigationManager Nav
@inject FortuneStateService State
@inject IJSRuntime JS

<div class="container py-4 max-w-850 mx-auto">
    <!-- Neumorphic Stepper -->
    <div class="neu-stepper">
        <div class="neu-step-item completed">
            <div class="neu-step-bubble"><i class="bi bi-check2"></i></div>
            <span>Path</span>
        </div>
        <div class="neu-step-divider"></div>
        <div class="neu-step-item completed">
            <div class="neu-step-bubble"><i class="bi bi-check2"></i></div>
            <span>Consent</span>
        </div>
        <div class="neu-step-divider"></div>
        <div class="neu-step-item active">
            <div class="neu-step-bubble">3</div>
            <span>Hand Photo</span>
        </div>
        <div class="neu-step-divider"></div>
        <div class="neu-step-item">
            <div class="neu-step-bubble">4</div>
            <span>Topic</span>
        </div>
    </div>

    <div class="neu-card p-4 p-md-5">
        <div class="text-center mb-4">
            <div class="d-inline-flex align-items-center gap-2 px-3 py-1 rounded-pill mb-2 neu-well-sm">
                <span class="text-neu-teal">✦</span>
                <span class="font-display text-neu-muted small text-uppercase fw-bold">Step 2B · Biometric Ingestion</span>
                <span class="text-neu-teal">✦</span>
            </div>
            <h2 class="font-display fw-extrabold text-neu-primary display-5 mb-1">SELECT HAND PHOTO</h2>
            <p class="font-body text-neu-muted max-w-600 mx-auto">
                Upload your hand photograph or choose an archetypal palm to begin in-memory line extraction.
            </p>
        </div>

        <!-- Deep Inset Scanner Viewport -->
        <div class="neu-scanner-well mb-4">
            @if (!string.IsNullOrEmpty(PreviewImage))
            {
                <img src="@PreviewImage" alt="Palm Preview" style="width: 100%; height: 100%; object-fit: contain; padding: 1rem;" />
                <div class="neu-scanner-laser"></div>
                <div class="position-absolute bottom-0 start-0 end-0 p-2 text-center text-neu-primary small font-display" style="background-color: rgba(224, 229, 236, 0.9); box-shadow: var(--shadow-inset-sm);">
                    <i class="bi bi-broadcast text-neu-teal me-1"></i> In-Memory Ready (@PhotoSizeKb KB)
                </div>
            }
            else
            {
                <div class="text-center p-4">
                    <div class="neu-icon-socket mb-3" style="width: 70px; height: 70px; font-size: 2.5rem; color: var(--neu-muted);">
                        ✋
                    </div>
                    <p class="font-display fw-bold text-neu-primary mb-1">No hand photo loaded.</p>
                    <small class="font-body text-neu-muted">Upload a photo below or select a sample archetype.</small>
                </div>
            }
        </div>

        <!-- Ingestion Controls -->
        <div class="row g-4 mb-4">
            <div class="col-md-6">
                <label class="form-label font-display fw-bold text-neu-primary small">
                    <i class="bi bi-cloud-arrow-up text-neu-accent me-1"></i> Upload Hand Photo
                </label>
                <div class="neu-well p-2">
                    <InputFile OnChange="HandleFileSelected" class="form-control border-0 bg-transparent text-neu-primary font-body small" accept="image/*" />
                </div>
                <small class="text-neu-muted font-body" style="font-size: 0.75rem;">Max payload: 5 MB (Gateway enforced)</small>
            </div>

            <div class="col-md-6">
                <label class="form-label font-display fw-bold text-neu-primary small">
                    <i class="bi bi-stars text-neu-teal me-1"></i> Or Select Hand Archetype
                </label>
                <div class="d-flex flex-wrap gap-2">
                    <button class="btn-neu-pill" @onclick='() => LoadPreset("Water", "Intuitive Water Hand")'>
                        💧 Water Hand
                    </button>
                    <button class="btn-neu-pill" @onclick='() => LoadPreset("Fire", "Dynamic Fire Hand")'>
                        🔥 Fire Hand
                    </button>
                    <button class="btn-neu-pill" @onclick='() => LoadPreset("Earth", "Grounded Earth Hand")'>
                        🌿 Earth Hand
                    </button>
                    <button class="btn-neu-pill" @onclick='() => LoadPreset("Air", "Intellectual Air Hand")'>
                        💨 Air Hand
                    </button>
                </div>
            </div>
        </div>

        @if (!string.IsNullOrEmpty(ErrorMessage))
        {
            <div class="neu-well p-3 text-danger font-display small mb-3">
                <i class="bi bi-exclamation-circle me-2"></i>@ErrorMessage
            </div>
        }

        <!-- Actions -->
        <div class="d-flex justify-content-between align-items-center mt-4">
            <a href="palm-permission" class="btn-neu">
                <i class="bi bi-arrow-left"></i> Privacy Consent
            </a>
            <button class="btn-neu-teal px-4 py-2" @onclick="ProceedToTopic">
                CONFIRM · CHOOSE TOPIC <i class="bi bi-arrow-right"></i>
            </button>
        </div>
    </div>
</div>

@code {
    private string? PreviewImage;
    private string? FileName;
    private long PhotoSizeKb;
    private string? ErrorMessage;

    protected override void OnInitialized()
    {
        if (!State.UserConsentGiven)
        {
            Nav.NavigateTo("palm-permission");
            return;
        }

        if (!string.IsNullOrEmpty(State.PalmImageBase64))
        {
            PreviewImage = State.PalmImageBase64;
            FileName = State.PalmFileName;
            PhotoSizeKb = (long)(PreviewImage.Length * 0.75 / 1024);
        }
        else
        {
            LoadPreset("Water", "Mystic Water Hand");
        }
    }

    private async Task HandleFileSelected(InputFileChangeEventArgs e)
    {
        ErrorMessage = null;
        var file = e.File;
        if (file == null) return;

        if (file.Size > DevCode.MaxPhotoSizeBytes)
        {
            ErrorMessage = $"Photo exceeds the {DevCode.MaxPhotoSizeBytes / (1024 * 1024)} MB gateway limit. Please choose a smaller image.";
            return;
        }

        try
        {
            using var stream = file.OpenReadStream(maxAllowedSize: DevCode.MaxPhotoSizeBytes);
            using var ms = new MemoryStream();
            await stream.CopyToAsync(ms);
            var bytes = ms.ToArray();
            var base64 = Convert.ToBase64String(bytes);

            PreviewImage = $"data:{file.ContentType};base64,{base64}";
            FileName = file.Name;
            PhotoSizeKb = bytes.Length / 1024;

            State.PalmImageBase64 = PreviewImage;
            State.PalmFileName = FileName;

            await JS.InvokeVoidAsync("fortuneAudio.playChime");
        }
        catch (Exception ex)
        {
            ErrorMessage = $"Could not load image: {ex.Message}";
        }
    }

    private void LoadPreset(string archetype, string title)
    {
        ErrorMessage = null;
        // Clean Neumorphic tone SVG
        var svg = $@"<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 400 400' width='400' height='400'>
            <rect width='400' height='400' fill='#E0E5EC'/>
            <!-- Hand Silhouette -->
            <path d='M130,350 C110,300 80,240 80,180 C80,150 90,120 110,100 C120,90 140,110 150,130 C155,100 165,70 185,60 C195,55 205,75 210,110 C220,80 230,50 250,50 C265,50 270,80 265,120 C280,95 295,95 305,110 C315,130 300,180 280,240 C310,250 330,280 320,310 C300,340 260,360 210,360 Z' fill='#E0E5EC' stroke='#A3B1C6' stroke-width='4' filter='drop-shadow(3px 3px 6px rgba(163,177,198,0.6))'/>
            <!-- Heart Line -->
            <path d='M120,180 Q200,160 290,140' fill='none' stroke='#6C63FF' stroke-width='3' stroke-dasharray='4,2'/>
            <text x='295' y='140' fill='#6C63FF' font-family='sans-serif' font-weight='bold' font-size='11'>Heart Line</text>
            <!-- Head Line -->
            <path d='M120,205 Q190,210 270,250' fill='none' stroke='#38B2AC' stroke-width='3' stroke-dasharray='4,2'/>
            <text x='275' y='255' fill='#38B2AC' font-family='sans-serif' font-weight='bold' font-size='11'>Head Line</text>
            <!-- Life Line -->
            <path d='M120,205 Q170,250 160,340' fill='none' stroke='#3D4852' stroke-width='3' stroke-dasharray='4,2'/>
            <text x='165' y='340' fill='#3D4852' font-family='sans-serif' font-weight='bold' font-size='11'>Life Line</text>
            <!-- Fate Line -->
            <path d='M210,350 L210,150' fill='none' stroke='#8B84FF' stroke-width='2' stroke-dasharray='2,2'/>
            <text x='215' y='160' fill='#8B84FF' font-family='sans-serif' font-weight='bold' font-size='11'>Fate Line</text>
            <text x='20' y='380' fill='#3D4852' font-family='sans-serif' font-weight='bold' font-size='13'>✦ {title} ({archetype})</text>
        </svg>";

        var base64 = Convert.ToBase64String(System.Text.Encoding.UTF8.GetBytes(svg));
        PreviewImage = $"data:image/svg+xml;base64,{base64}";
        FileName = $"{archetype}_Hand_Preset.svg";
        PhotoSizeKb = 4;

        State.PalmImageBase64 = PreviewImage;
        State.PalmFileName = FileName;
    }

    private void ProceedToTopic()
    {
        if (string.IsNullOrEmpty(State.PalmImageBase64))
        {
            ErrorMessage = "Please select or upload a hand photo before proceeding.";
            return;
        }

        Nav.NavigateTo("topic-select");
    }
}
