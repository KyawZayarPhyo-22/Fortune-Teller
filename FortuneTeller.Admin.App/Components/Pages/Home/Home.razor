@page "/"
@page "/choose-reading"
@using FortuneTeller.Share.Readings
@inject NavigationManager Nav
@inject FortuneStateService State
@inject IJSRuntime JS

<div class="initial-screen-container">
    <!-- Header -->
    <div class="text-center mb-3 mb-md-4">
        <div class="d-inline-flex align-items-center gap-2 px-3 py-1 rounded-pill mb-2 neu-well-sm">
            <span class="text-neu-accent">✦</span>
            <span class="font-display text-neu-muted small text-uppercase fw-bold" style="letter-spacing: 0.1em; font-size: 0.75rem;">
                အက်စ်ထရီယာ နက္ခတ်ဗေဒင်နန်းတော်
            </span>
            <span class="text-neu-accent">✦</span>
        </div>

        <h1 class="font-display fw-extrabold text-neu-primary mb-1 display-6">
            ဗေဒင်ဟောကြားမှု ပုံစံရွေးချယ်ပါ
        </h1>
        <p class="font-body text-neu-muted small max-w-500 mx-auto mb-0">
            တာရော့ကတ် သို့မဟုတ် လက်ဝါးလက္ခဏာဓာတ်ပုံ ရွေးချယ်၍ ကံကြမ္မာကို စတင်ဟောကြားပါ
        </p>
    </div>

    <!-- The Two Direct Neumorphic Cards -->
    <div class="row g-3 g-md-4 justify-content-center w-100 max-w-850">
        <!-- Tarot Card -->
        <div class="col-sm-6 col-md-5">
            <div class="neu-card neu-card-lift p-3 p-md-4 text-center h-100 d-flex flex-column justify-content-between option-card"
                 style="cursor: pointer;"
                 @onclick="SelectTarot">
                <div>
                    <!-- Concentric Depth Icon Ring -->
                    <div class="compact-concentric-outer mb-3">
                        <div class="compact-concentric-inner text-neu-accent">
                            🎴
                        </div>
                    </div>

                    <h2 class="font-display fw-bold text-neu-primary h4 mb-1">တာရော့ ဗေဒင်</h2>
                    <p class="font-body text-neu-muted small mb-3" style="line-height: 1.5; font-size: 0.85rem;">
                        တာရော့ကတ် ၇၈ ကတ်ဖြင့် အတိတ်၊ ပစ္စုပ္ပန်၊ အနာဂတ် ကံကြမ္မာကြိုးမျှင်များကို ဖွင့်လှစ်ကြည့်ရှုပါ။
                    </p>
                </div>
                <div>
                    <button class="btn-neu-primary w-100 py-2 fs-6" @onclick="SelectTarot" @onclick:stopPropagation="true">
                        <i class="bi bi-stars"></i> တာရော့ဖြင့် ဟောမည်
                    </button>
                </div>
            </div>
        </div>

        <!-- Palm Photo Card -->
        <div class="col-sm-6 col-md-5">
            <div class="neu-card neu-card-lift p-3 p-md-4 text-center h-100 d-flex flex-column justify-content-between option-card"
                 style="cursor: pointer;"
                 @onclick="SelectPalm">
                <div>
                    <!-- Concentric Depth Icon Ring -->
                    <div class="compact-concentric-outer mb-3">
                        <div class="compact-concentric-inner text-neu-teal">
                            ✋
                        </div>
                    </div>

                    <h2 class="font-display fw-bold text-neu-primary h4 mb-1">လက်ဝါးလက္ခဏာ ဗေဒင်</h2>
                    <p class="font-body text-neu-muted small mb-3" style="line-height: 1.5; font-size: 0.85rem;">
                        အသက်၊ နှလုံး၊ ဦးခေါင်းနှင့် ကံကြမ္မာ လမ်းကြောင်းများကို တိုက်ရိုက် ခွဲခြမ်းစိတ်ဖြာ ဟောကြားပေးပါသည်။
                    </p>
                </div>
                <div>
                    <button class="btn-neu-teal w-100 py-2 fs-6" @onclick="SelectPalm" @onclick:stopPropagation="true">
                        <i class="bi bi-hand-index-thumb"></i> လက်ဝါးဖြင့် ဟောမည်
                    </button>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    .initial-screen-container {
        height: 100vh;
        max-height: 100vh;
        width: 100%;
        overflow: hidden;
        display: flex;
        flex-direction: column;
        justify-content: center;
        align-items: center;
        padding: 1rem;
        background: transparent;
    }

    .option-card {
        min-height: 310px;
        transition: all 0.3s cubic-bezier(0.16, 1, 0.3, 1);
    }

    .option-card:hover {
        transform: translateY(-5px);
    }

    .compact-concentric-outer {
        width: 96px;
        height: 96px;
        border-radius: 50%;
        background: rgba(22, 28, 40, 0.75);
        backdrop-filter: blur(14px);
        -webkit-backdrop-filter: blur(14px);
        border: 1px solid rgba(255, 255, 255, 0.16);
        box-shadow: 0 12px 28px rgba(0, 0, 0, 0.55),
                    inset 0 1px 2px rgba(255, 255, 255, 0.25);
        display: flex;
        align-items: center;
        justify-content: center;
        margin: 0 auto;
        transition: transform 0.4s ease-out;
    }

    .compact-concentric-inner {
        width: 68px;
        height: 68px;
        border-radius: 50%;
        background: rgba(8, 11, 18, 0.9);
        border: 1px solid rgba(255, 255, 255, 0.1);
        box-shadow: inset 4px 4px 12px rgba(0, 0, 0, 0.85),
                    inset -2px -2px 6px rgba(255, 255, 255, 0.05);
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 2.2rem;
        transition: transform 0.4s ease-out;
    }

    .option-card:hover .compact-concentric-outer {
        transform: scale(1.06);
        border-color: rgba(245, 158, 11, 0.5);
        box-shadow: 0 16px 36px rgba(0, 0, 0, 0.65), 0 0 20px rgba(245, 158, 11, 0.25);
    }

    .option-card:hover .compact-concentric-inner {
        transform: rotate(8deg);
    }
</style>

@code {
    private async Task SelectTarot()
    {
        try { await JS.InvokeVoidAsync("fortuneCamera.clearPalmCache"); } catch { }
        State.Reset();
        State.ReadingType = ReadingType.Tarot;
        try { await JS.InvokeVoidAsync("fortuneAudio.playCardFlip"); } catch { }
        Nav.NavigateTo("tarot-spread");
    }

    private async Task SelectPalm()
    {
        try { await JS.InvokeVoidAsync("fortuneCamera.clearPalmCache"); } catch { }
        State.Reset();
        State.ReadingType = ReadingType.Palm;
        State.UserConsentGiven = true;
        try { await JS.InvokeVoidAsync("fortuneAudio.playChime"); } catch { }
        Nav.NavigateTo("palm-capture");
    }
}
