@page "/"
@inject NavigationManager Nav
@inject FortuneStateService State
@inject FortuneClientService Client
@inject IJSRuntime JS

<div class="container py-4 text-center">
    <!-- Hero Section -->
    <div class="py-5">
        <div class="mb-4">
            <span class="badge rounded-pill px-3 py-2 text-uppercase font-oracle"
                  style="background: rgba(168, 85, 247, 0.2); border: 1px solid var(--amethyst-primary); color: var(--gold-light); font-size: 0.85rem;">
                ✦ Sacred Esoteric Intelligence ✦
            </span>
        </div>

        <h1 class="display-3 font-decorative gold-gradient-text mb-3" style="font-weight: 900;">
            THE CELESTIAL ORACLE
        </h1>
        <p class="lead text-light opacity-75 max-w-700 mx-auto mb-5 font-oracle" style="font-size: 1.25rem;">
            Consult the ancient stars through Tarot divination or discover the indelible map of your soul etched into your palm lines.
        </p>

        <!-- Mystical Crystal Orb -->
        <div class="my-5 position-relative d-inline-block">
            <div class="rounded-circle pulse-ring d-flex align-items-center justify-content-center mx-auto"
                 style="width: 190px; height: 190px; background: radial-gradient(circle at 35% 35%, rgba(255, 209, 102, 0.9) 0%, rgba(168, 85, 247, 0.8) 50%, rgba(15, 10, 36, 0.95) 100%); box-shadow: 0 0 50px rgba(168, 85, 247, 0.6), inset 0 0 30px rgba(255, 255, 255, 0.5); cursor: pointer;"
                 @onclick="StartReading">
                <span style="font-size: 4.5rem; filter: drop-shadow(0 0 15px rgba(255, 255, 255, 0.9));">🔮</span>
            </div>
            <div class="mt-3 text-secondary small font-oracle">Click the Sacred Orb to Awaken the Oracle</div>
        </div>

        <div class="d-flex justify-content-center gap-3 mt-4">
            <button class="btn-cosmic-gold fs-5 px-5 py-3" @onclick="StartReading">
                <i class="bi bi-stars"></i> START A READING
            </button>
            <a href="history" class="btn-cosmic-purple fs-5 px-4 py-3">
                <i class="bi bi-clock-history"></i> Reading Archive
            </a>
        </div>
    </div>

    <!-- Divination Modalities Feature Cards -->
    <div class="row g-4 mt-4 text-start">
        <div class="col-md-6">
            <div class="fortune-glass-card p-4 h-100" style="cursor: pointer;" @onclick="StartTarot">
                <div class="d-flex align-items-center gap-3 mb-3">
                    <span class="fs-1" style="color: var(--gold-primary);">🎴</span>
                    <div>
                        <h3 class="font-oracle text-white h4 mb-0">Tarot Divination</h3>
                        <small class="text-secondary font-oracle">78 Sacred Cards · In-Memory Spreads</small>
                    </div>
                </div>
                <p class="text-white-50">
                    Draw from the Major & Minor Arcana. Unveil hidden influences, emotional crossroads, and karmic destiny through the Trinity of Time or Celestial Pentagram.
                </p>
                <div class="d-flex justify-content-between align-items-center mt-3 text-warning">
                    <span class="small font-oracle">Explore Spread & Cards ➔</span>
                    <span class="badge bg-warning bg-opacity-10 text-warning border border-warning border-opacity-25">Instant Draw</span>
                </div>
            </div>
        </div>

        <div class="col-md-6">
            <div class="fortune-glass-card p-4 h-100" style="cursor: pointer;" @onclick="StartPalm">
                <div class="d-flex align-items-center gap-3 mb-3">
                    <span class="fs-1" style="color: var(--astral-cyan);">✋</span>
                    <div>
                        <h3 class="font-oracle text-white h4 mb-0">Palmistry Analysis</h3>
                        <small class="text-secondary font-oracle">In-Memory Biometric Reading · Privacy First</small>
                    </div>
                </div>
                <p class="text-white-50">
                    Your palm is the celestial blueprint of your vitality. Ephemeral in-memory image processing maps your Life, Heart, Head, and Fate lines with zero permanent storage.
                </p>
                <div class="d-flex justify-content-between align-items-center mt-3 text-info">
                    <span class="small font-oracle">Capture & Scan Hand ➔</span>
                    <span class="badge bg-info bg-opacity-10 text-info border border-info border-opacity-25">Ephemeral</span>
                </div>
            </div>
        </div>
    </div>

    <!-- System Architecture Banner -->
    <div class="mt-5 p-4 rounded-4" style="background: rgba(20, 15, 45, 0.5); border: 1px dashed var(--cosmic-border);">
        <div class="row align-items-center">
            <div class="col-lg-3 text-center text-lg-start mb-3 mb-lg-0">
                <span class="text-uppercase small font-oracle" style="color: var(--gold-primary);">SYSTEM STATUS</span>
                <h5 class="text-white font-oracle mb-0">Orchestrator Online</h5>
            </div>
            <div class="col-lg-9">
                <div class="d-flex flex-wrap justify-content-center justify-content-lg-end gap-3 text-center small text-white-50">
                    <div class="px-3 py-2 rounded-3 bg-black bg-opacity-25 border border-secondary border-opacity-25">
                        <div class="text-warning fw-bold">@Stats.TotalReadingsProcessed</div>
                        <div>Readings Done</div>
                    </div>
                    <div class="px-3 py-2 rounded-3 bg-black bg-opacity-25 border border-secondary border-opacity-25">
                        <div class="text-info fw-bold">@DevCode.RateLimitPerMinute req/m</div>
                        <div>Gateway Rate Limit</div>
                    </div>
                    <div class="px-3 py-2 rounded-3 bg-black bg-opacity-25 border border-secondary border-opacity-25">
                        <div class="text-success fw-bold">@(DevCode.MaxPhotoSizeBytes / (1024 * 1024)) MB</div>
                        <div>Max Photo Size</div>
                    </div>
                    <div class="px-3 py-2 rounded-3 bg-black bg-opacity-25 border border-secondary border-opacity-25">
                        <div class="text-primary fw-bold">In-Memory</div>
                        <div>Zero Data Leak</div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@code {
    private OrchestratorStatsModel Stats = new();

    protected override void OnInitialized()
    {
        Stats = Client.GetStats();
    }

    private async Task StartReading()
    {
        try { await JS.InvokeVoidAsync("fortuneAudio.playChime"); } catch { }
        State.Reset();
        Nav.NavigateTo("choose-reading");
    }

    private async Task StartTarot()
    {
        try { await JS.InvokeVoidAsync("fortuneAudio.playChime"); } catch { }
        State.Reset();
        State.ReadingType = ReadingType.Tarot;
        Nav.NavigateTo("tarot-spread");
    }

    private async Task StartPalm()
    {
        try { await JS.InvokeVoidAsync("fortuneAudio.playChime"); } catch { }
        State.Reset();
        State.ReadingType = ReadingType.Palm;
        Nav.NavigateTo("palm-permission");
    }
}
