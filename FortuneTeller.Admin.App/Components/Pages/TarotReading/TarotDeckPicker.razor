@page "/tarot-picker"
@inject NavigationManager Nav
@inject FortuneStateService State
@inject FortuneClientService Client
@inject IJSRuntime JS

<div class="container py-4 max-w-1000 mx-auto">
    <!-- Stepper -->
    <div class="neu-stepper">
        <div class="neu-step-item completed">
            <div class="neu-step-bubble"><i class="bi bi-check2"></i></div>
            <span>Path</span>
        </div>
        <div class="neu-step-divider"></div>
        <div class="neu-step-item completed">
            <div class="neu-step-bubble"><i class="bi bi-check2"></i></div>
            <span>Spread</span>
        </div>
        <div class="neu-step-divider"></div>
        <div class="neu-step-item active">
            <div class="neu-step-bubble">3</div>
            <span>Draw Cards</span>
        </div>
        <div class="neu-step-divider"></div>
        <div class="neu-step-item">
            <div class="neu-step-bubble">4</div>
            <span>Topic</span>
        </div>
    </div>

    <!-- Title -->
    <div class="text-center mb-4">
        <div class="d-inline-flex align-items-center gap-2 px-3 py-1 rounded-pill mb-2 neu-well-sm">
            <span class="text-neu-accent">✦</span>
            <span class="font-display text-neu-muted small text-uppercase fw-bold">Step 2B · In-Memory Deck Selection</span>
            <span class="text-neu-accent">✦</span>
        </div>
        <h2 class="font-display fw-extrabold text-neu-primary display-5 mb-1">DRAW YOUR CARDS</h2>
        <p class="font-body text-neu-muted max-w-600 mx-auto mb-2">
            Selected Spread: <span class="text-neu-accent fw-bold font-display">@SpreadInfo.Title</span>
            (Draw @SpreadInfo.CardCount card@(SpreadInfo.CardCount > 1 ? "s" : ""))
        </p>
        <div class="small font-display text-neu-muted">
            Selected: <span class="text-neu-accent fw-bold">@DrawnCards.Count</span> of @SpreadInfo.CardCount
        </div>
    </div>

    <!-- Active Drawn Cards Display -->
    <div class="row g-3 justify-content-center my-4">
        @for (int i = 0; i < SpreadInfo.CardCount; i++)
        {
            var posIndex = i;
            var posName = i < SpreadInfo.Positions.Count ? SpreadInfo.Positions[i] : $"Position {i + 1}";
            var hasDrawn = posIndex < DrawnCards.Count;
            var card = hasDrawn ? DrawnCards[posIndex] : null;

            <div class="col-6 col-md-4 col-lg-3 text-center">
                <div class="small font-display fw-semibold text-neu-muted mb-2 text-truncate" title="@posName">
                    @posName
                </div>

                <div class="neu-tarot-card mx-auto @(hasDrawn ? "selected" : "")">
                    @if (hasDrawn && card != null)
                    {
                        <!-- Revealed Card Face -->
                        <div class="d-flex justify-content-between align-items-center">
                            <span class="btn-neu-pill py-0 px-2 small font-display text-neu-accent fw-bold" style="font-size: 0.7rem;">
                                #@card.Number
                            </span>
                            <span class="btn-neu-pill py-0 px-2 small font-display" style="font-size: 0.65rem;">
                                @card.Element
                            </span>
                        </div>

                        <div class="my-2">
                            <div class="neu-icon-socket mx-auto mb-2" style="font-size: 2rem;">
                                @card.Symbol
                            </div>
                            <h6 class="font-display fw-bold text-neu-primary text-truncate mb-0">@card.Name</h6>
                            <small class="text-neu-muted font-body" style="font-size: 0.7rem;">@card.Keywords</small>
                        </div>

                        <div class="neu-well-sm p-2 text-neu-muted font-body" style="font-size: 0.7rem; line-height: 1.3;">
                            @card.UprightMeaning
                        </div>
                    }
                    else
                    {
                        <!-- Face-down Card Back Pattern -->
                        <div class="neu-card-back-pattern">
                            <div class="neu-icon-socket mb-2" style="width: 52px; height: 52px; font-size: 1.6rem;">
                                🔮
                            </div>
                            <div class="font-display fw-bold text-neu-muted small">ASTRAEA</div>
                            <small class="text-neu-muted" style="font-size: 0.65rem;">Tap Deck Below</small>
                        </div>
                    }
                </div>
            </div>
        }
    </div>

    <!-- Tactile In-Memory Deck Drawer -->
    <div class="neu-card p-4 mt-4">
        @if (DrawnCards.Count < SpreadInfo.CardCount)
        {
            <div class="text-center mb-3">
                <h5 class="font-display fw-bold text-neu-primary mb-1">
                    <i class="bi bi-hand-index-thumb text-neu-accent"></i> Click an Archetype to Draw from Memory:
                </h5>
                <small class="text-neu-muted font-body">Volatile in-memory card deck</small>
            </div>

            <!-- Inset Card Well -->
            <div class="neu-well-deep p-3 d-flex justify-content-center flex-wrap gap-2 mb-3">
                @foreach (var availableCard in AvailableCardsSample)
                {
                    <div class="neu-card p-2 text-center"
                         style="width: 85px; height: 110px; cursor: pointer; border-radius: 14px; transition: transform 0.2s ease-out;"
                         @onclick="() => DrawSpecificCard(availableCard)">
                        <div class="neu-icon-socket mx-auto mb-1" style="width: 38px; height: 38px; font-size: 1.2rem;">
                            @availableCard.Symbol
                        </div>
                        <div class="font-display fw-bold text-neu-primary text-truncate" style="font-size: 0.7rem;">
                            @availableCard.Name
                        </div>
                    </div>
                }
            </div>

            <div class="text-center">
                <button class="btn-neu" @onclick="CosmicAutoDraw">
                    <i class="bi bi-shuffle text-neu-accent"></i> Auto-Shuffle & Draw All
                </button>
            </div>
        }
        else
        {
            <div class="text-center py-2">
                <div class="neu-icon-socket mx-auto mb-3" style="width: 60px; height: 60px; font-size: 2rem; color: var(--neu-accent-secondary);">
                    <i class="bi bi-check2-circle"></i>
                </div>
                <h4 class="font-display fw-bold text-neu-primary mb-1">All Cards Drawn in Memory!</h4>
                <p class="font-body text-neu-muted small mb-3">Your spread configuration is locked. Proceed to specify your inquiry.</p>
                <button class="btn-neu-pill" @onclick="ResetDraw">
                    <i class="bi bi-arrow-counterclockwise"></i> Redraw Spread
                </button>
            </div>
        }
    </div>

    <!-- Actions -->
    <div class="d-flex justify-content-between align-items-center mt-4">
        <a href="tarot-spread" class="btn-neu">
            <i class="bi bi-arrow-left"></i> Change Spread
        </a>
        <button class="btn-neu-primary px-4 py-2 @(DrawnCards.Count < SpreadInfo.CardCount ? "disabled opacity-50" : "")"
                @onclick="ProceedToTopic">
            CHOOSE TOPIC & INQUIRY <i class="bi bi-arrow-right"></i>
        </button>
    </div>
</div>

@code {
    private TarotSpreadInfoModel SpreadInfo = new();
    private List<TarotCardModel> DrawnCards = new();
    private List<TarotCardModel> AllCards = new();
    private List<TarotCardModel> AvailableCardsSample = new();

    protected override void OnInitialized()
    {
        SpreadInfo = Client.GetSpreadInfo(State.SpreadType);
        AllCards = Client.GetAllTarotCards().ToList();

        var rng = new Random();
        AvailableCardsSample = AllCards.OrderBy(_ => rng.Next()).Take(8).ToList();

        if (State.SelectedCardIds.Count > 0)
        {
            foreach (var id in State.SelectedCardIds.Take(SpreadInfo.CardCount))
            {
                var card = AllCards.FirstOrDefault(c => c.Id == id);
                if (card != null) DrawnCards.Add(card);
            }
        }
    }

    private async Task DrawSpecificCard(TarotCardModel card)
    {
        if (DrawnCards.Count >= SpreadInfo.CardCount) return;
        if (DrawnCards.Any(c => c.Id == card.Id)) return;

        DrawnCards.Add(card);
        AvailableCardsSample.Remove(card);

        try { await JS.InvokeVoidAsync("fortuneAudio.playCardFlip"); } catch { }
        UpdateState();
    }

    private async Task CosmicAutoDraw()
    {
        var rng = new Random();
        var remainingNeeded = SpreadInfo.CardCount - DrawnCards.Count;
        var unselected = AllCards.Where(c => !DrawnCards.Any(d => d.Id == c.Id)).OrderBy(_ => rng.Next()).Take(remainingNeeded);

        foreach (var card in unselected)
        {
            DrawnCards.Add(card);
        }

        try { await JS.InvokeVoidAsync("fortuneAudio.playChime"); } catch { }
        UpdateState();
    }

    private void ResetDraw()
    {
        DrawnCards.Clear();
        var rng = new Random();
        AvailableCardsSample = AllCards.OrderBy(_ => rng.Next()).Take(8).ToList();
        UpdateState();
    }

    private void UpdateState()
    {
        State.SelectedCardIds = DrawnCards.Select(c => c.Id).ToList();
    }

    private void ProceedToTopic()
    {
        if (DrawnCards.Count < SpreadInfo.CardCount)
        {
            CosmicAutoDraw().Wait();
        }

        UpdateState();
        Nav.NavigateTo("topic-select");
    }
}
