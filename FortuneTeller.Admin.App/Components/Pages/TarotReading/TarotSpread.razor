@page "/tarot-spread"
@inject NavigationManager Nav
@inject FortuneStateService State
@inject FortuneClientService Client
@inject IJSRuntime JS

<div class="container py-4 max-w-900 mx-auto">
    <!-- Stepper -->
    <div class="wizard-stepper">
        <div class="step-item completed">
            <div class="step-bubble"><i class="bi bi-check"></i></div>
            <span>Choose Path</span>
        </div>
        <div class="step-divider"></div>
        <div class="step-item active">
            <div class="step-bubble">2</div>
            <span>Select Spread</span>
        </div>
        <div class="step-divider"></div>
        <div class="step-item">
            <div class="step-bubble">3</div>
            <span>Draw Cards</span>
        </div>
        <div class="step-divider"></div>
        <div class="step-item">
            <div class="step-bubble">4</div>
            <span>Topic & Inquiry</span>
        </div>
    </div>

    <!-- Title -->
    <div class="text-center mb-5">
        <span class="badge rounded-pill px-3 py-1 text-uppercase font-oracle text-warning mb-2"
              style="background: rgba(255, 209, 102, 0.1); border: 1px solid rgba(255, 209, 102, 0.3);">
            Step 2 · The Sacred Astral Spreads
        </span>
        <h2 class="font-decorative gold-gradient-text">SELECT YOUR TAROT SPREAD</h2>
        <p class="text-secondary font-oracle max-w-600 mx-auto">
            Choose how many celestial lenses you wish to invoke to view your destiny.
        </p>
    </div>

    <div class="row g-4">
        <!-- 1 Card Spread -->
        <div class="col-md-4">
            <div class="fortune-glass-card p-4 h-100 d-flex flex-column justify-content-between @(SelectedSpread == TarotSpreadType.SingleCard ? "border-warning" : "")"
                 style="cursor: pointer;"
                 @onclick="() => SelectSpread(TarotSpreadType.SingleCard)">
                <div>
                    <div class="d-flex justify-content-between align-items-center mb-3">
                        <span class="badge bg-warning bg-opacity-20 text-warning font-oracle">1 Card</span>
                        <span class="fs-4">👁️</span>
                    </div>
                    <h4 class="font-oracle text-white mb-2">Oracle's Eye</h4>
                    <p class="small text-white-50 mb-3">
                        A focused beam of cosmic clarity. Perfect for immediate questions, daily guidance, or rapid alignment.
                    </p>
                    <div class="p-2 rounded bg-black bg-opacity-30 small text-secondary">
                        <strong>Position:</strong> The Core Revelation
                    </div>
                </div>
                <div class="mt-4">
                    <button class="btn @(SelectedSpread == TarotSpreadType.SingleCard ? "btn-cosmic-gold" : "btn-cosmic-outline") w-100">
                        Select Single Card
                    </button>
                </div>
            </div>
        </div>

        <!-- 3 Cards Spread -->
        <div class="col-md-4">
            <div class="fortune-glass-card p-4 h-100 d-flex flex-column justify-content-between @(SelectedSpread == TarotSpreadType.ThreeCards ? "border-warning" : "")"
                 style="cursor: pointer;"
                 @onclick="() => SelectSpread(TarotSpreadType.ThreeCards)">
                <div>
                    <div class="d-flex justify-content-between align-items-center mb-3">
                        <span class="badge bg-warning text-dark fw-bold font-oracle">3 Cards · Recommended</span>
                        <span class="fs-4">⏳</span>
                    </div>
                    <h4 class="font-oracle text-white mb-2">Trinity of Time</h4>
                    <p class="small text-white-50 mb-3">
                        Weaves past root causes, current active energies, and future outcomes into a seamless divine narrative.
                    </p>
                    <div class="p-2 rounded bg-black bg-opacity-30 small text-secondary">
                        <strong>Positions:</strong> Past · Present · Destiny
                    </div>
                </div>
                <div class="mt-4">
                    <button class="btn @(SelectedSpread == TarotSpreadType.ThreeCards ? "btn-cosmic-gold" : "btn-cosmic-outline") w-100">
                        Select 3-Card Trinity
                    </button>
                </div>
            </div>
        </div>

        <!-- 5 Cards Spread -->
        <div class="col-md-4">
            <div class="fortune-glass-card p-4 h-100 d-flex flex-column justify-content-between @(SelectedSpread == TarotSpreadType.FiveCards ? "border-warning" : "")"
                 style="cursor: pointer;"
                 @onclick="() => SelectSpread(TarotSpreadType.FiveCards)">
                <div>
                    <div class="d-flex justify-content-between align-items-center mb-3">
                        <span class="badge bg-warning bg-opacity-20 text-warning font-oracle">5 Cards</span>
                        <span class="fs-4">⭐</span>
                    </div>
                    <h4 class="font-oracle text-white mb-2">Celestial Pentagram</h4>
                    <p class="small text-white-50 mb-3">
                        An elemental cross analyzing Spirit, Shadow Obstacles, Divine Allies, Subconscious Truth, and Ultimate Fate.
                    </p>
                    <div class="p-2 rounded bg-black bg-opacity-30 small text-secondary">
                        <strong>Positions:</strong> 5 Elemental Gateways
                    </div>
                </div>
                <div class="mt-4">
                    <button class="btn @(SelectedSpread == TarotSpreadType.FiveCards ? "btn-cosmic-gold" : "btn-cosmic-outline") w-100">
                        Select Pentagram
                    </button>
                </div>
            </div>
        </div>
    </div>

    <div class="d-flex justify-content-between align-items-center mt-5">
        <a href="choose-reading" class="btn-cosmic-outline">
            <i class="bi bi-arrow-left"></i> Back to Method
        </a>
        <button class="btn-cosmic-gold px-4 py-2" @onclick="ProceedToCardDraw">
            PROCEED TO DRAW CARDS <i class="bi bi-arrow-right"></i>
        </button>
    </div>
</div>

@code {
    private TarotSpreadType SelectedSpread = TarotSpreadType.ThreeCards;

    protected override void OnInitialized()
    {
        SelectedSpread = State.SpreadType;
    }

    private async Task SelectSpread(TarotSpreadType spread)
    {
        SelectedSpread = spread;
        State.SpreadType = spread;
        try { await JS.InvokeVoidAsync("fortuneAudio.playCardFlip"); } catch { }
    }

    private void ProceedToCardDraw()
    {
        State.SpreadType = SelectedSpread;
        Nav.NavigateTo("tarot-picker");
    }
}
