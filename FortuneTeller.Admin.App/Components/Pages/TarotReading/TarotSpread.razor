@page "/tarot-spread"
@inject NavigationManager Nav
@inject FortuneStateService State
@inject FortuneClientService Client
@inject IJSRuntime JS

<div class="container py-4 max-w-950 mx-auto">
    <!-- Neumorphic Stepper -->
    <div class="neu-stepper">
        <div class="neu-step-item completed">
            <div class="neu-step-bubble"><i class="bi bi-check2"></i></div>
            <span>Path</span>
        </div>
        <div class="neu-step-divider"></div>
        <div class="neu-step-item active">
            <div class="neu-step-bubble">2</div>
            <span>Select Spread</span>
        </div>
        <div class="neu-step-divider"></div>
        <div class="neu-step-item">
            <div class="neu-step-bubble">3</div>
            <span>Draw Cards</span>
        </div>
        <div class="neu-step-divider"></div>
        <div class="neu-step-item">
            <div class="neu-step-bubble">4</div>
            <span>Topic</span>
        </div>
    </div>

    <!-- Title Header -->
    <div class="text-center mb-5">
        <div class="d-inline-flex align-items-center gap-2 px-3 py-1 rounded-pill mb-3 neu-well-sm">
            <span class="text-neu-accent">✦</span>
            <span class="font-display text-neu-muted small text-uppercase fw-bold">Step 2 · Sacred Spread Configuration</span>
            <span class="text-neu-accent">✦</span>
        </div>
        <h2 class="font-display fw-extrabold text-neu-primary display-5 mb-2">SELECT YOUR TAROT SPREAD</h2>
        <p class="font-body text-neu-muted max-w-600 mx-auto">
            Choose the depth of the inquiry to cast upon the in-memory card orchestrator.
        </p>
    </div>

    <div class="row g-4">
        <!-- 1 Card Spread -->
        <div class="col-md-4">
            <div class="neu-card neu-card-lift p-4 h-100 d-flex flex-column justify-content-between @(SelectedSpread == TarotSpreadType.SingleCard ? "neu-well-deep" : "")"
                 style="cursor: pointer;"
                 @onclick="() => SelectSpread(TarotSpreadType.SingleCard)">
                <div>
                    <div class="d-flex justify-content-between align-items-center mb-4">
                        <span class="btn-neu-pill small font-display">1 Card</span>
                        <div class="neu-icon-socket" style="width: 48px; height: 48px; font-size: 1.5rem;">
                            👁️
                        </div>
                    </div>
                    <h4 class="font-display fw-bold text-neu-primary mb-2">Oracle's Eye</h4>
                    <p class="font-body small text-neu-muted mb-3" style="line-height: 1.6;">
                        A focused beam of clarity for rapid insight, daily truth, or singular decisions.
                    </p>
                    <div class="neu-well p-3 small text-neu-muted font-display">
                        <strong class="text-neu-primary">Position:</strong> The Core Revelation
                    </div>
                </div>
                <div class="mt-4">
                    <button class="btn @(SelectedSpread == TarotSpreadType.SingleCard ? "btn-neu-primary" : "btn-neu") w-100">
                        Select Single Card
                    </button>
                </div>
            </div>
        </div>

        <!-- 3 Cards Spread -->
        <div class="col-md-4">
            <div class="neu-card neu-card-lift p-4 h-100 d-flex flex-column justify-content-between @(SelectedSpread == TarotSpreadType.ThreeCards ? "neu-well-deep" : "")"
                 style="cursor: pointer;"
                 @onclick="() => SelectSpread(TarotSpreadType.ThreeCards)">
                <div>
                    <div class="d-flex justify-content-between align-items-center mb-4">
                        <span class="btn-neu-pill small font-display text-neu-accent fw-bold">3 Cards · Recommended</span>
                        <div class="neu-icon-socket" style="width: 48px; height: 48px; font-size: 1.5rem;">
                            ⏳
                        </div>
                    </div>
                    <h4 class="font-display fw-bold text-neu-primary mb-2">Trinity of Time</h4>
                    <p class="font-body small text-neu-muted mb-3" style="line-height: 1.6;">
                        Connects past root causes, current active forces, and the resulting future destiny.
                    </p>
                    <div class="neu-well p-3 small text-neu-muted font-display">
                        <strong class="text-neu-primary">Positions:</strong> Past · Present · Destiny
                    </div>
                </div>
                <div class="mt-4">
                    <button class="btn @(SelectedSpread == TarotSpreadType.ThreeCards ? "btn-neu-primary" : "btn-neu") w-100">
                        Select 3-Card Trinity
                    </button>
                </div>
            </div>
        </div>

        <!-- 5 Cards Spread -->
        <div class="col-md-4">
            <div class="neu-card neu-card-lift p-4 h-100 d-flex flex-column justify-content-between @(SelectedSpread == TarotSpreadType.FiveCards ? "neu-well-deep" : "")"
                 style="cursor: pointer;"
                 @onclick="() => SelectSpread(TarotSpreadType.FiveCards)">
                <div>
                    <div class="d-flex justify-content-between align-items-center mb-4">
                        <span class="btn-neu-pill small font-display">5 Cards</span>
                        <div class="neu-icon-socket" style="width: 48px; height: 48px; font-size: 1.5rem;">
                            ⭐
                        </div>
                    </div>
                    <h4 class="font-display fw-bold text-neu-primary mb-2">Celestial Pentagram</h4>
                    <p class="font-body small text-neu-muted mb-3" style="line-height: 1.6;">
                        An elemental cross analyzing Spirit, Hidden Obstacles, Divine Allies, Subconscious Truth, and Fate.
                    </p>
                    <div class="neu-well p-3 small text-neu-muted font-display">
                        <strong class="text-neu-primary">Positions:</strong> 5 Elemental Gateways
                    </div>
                </div>
                <div class="mt-4">
                    <button class="btn @(SelectedSpread == TarotSpreadType.FiveCards ? "btn-neu-primary" : "btn-neu") w-100">
                        Select Pentagram
                    </button>
                </div>
            </div>
        </div>
    </div>

    <!-- Navigation Actions -->
    <div class="d-flex justify-content-between align-items-center mt-5">
        <a href="choose-reading" class="btn-neu">
            <i class="bi bi-arrow-left"></i> Back to Path
        </a>
        <button class="btn-neu-primary px-4 py-2" @onclick="ProceedToCardDraw">
            DRAW CARDS <i class="bi bi-arrow-right"></i>
        </button>
    </div>
</div>

@code {
    private TarotSpreadType SelectedSpread = TarotSpreadType.ThreeCards;

    protected override void OnInitialized()
    {
        SelectedSpread = State.SpreadType;
    }

    private async Task SelectSpread(TarotSpreadType spread)
    {
        SelectedSpread = spread;
        State.SpreadType = spread;
        try { await JS.InvokeVoidAsync("fortuneAudio.playCardFlip"); } catch { }
    }

    private void ProceedToCardDraw()
    {
        State.SpreadType = SelectedSpread;
        Nav.NavigateTo("tarot-picker");
    }
}
