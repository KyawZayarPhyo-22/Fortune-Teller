@page "/topic-select"
@inject NavigationManager Nav
@inject FortuneStateService State
@inject IJSRuntime JS

<div class="container py-4 max-w-850 mx-auto">
    <!-- Stepper -->
    <div class="wizard-stepper">
        <div class="step-item completed">
            <div class="step-bubble"><i class="bi bi-check"></i></div>
            <span>Path</span>
        </div>
        <div class="step-divider"></div>
        <div class="step-item completed">
            <div class="step-bubble"><i class="bi bi-check"></i></div>
            <span>Method</span>
        </div>
        <div class="step-divider"></div>
        <div class="step-item active">
            <div class="step-bubble">3</div>
            <span>Topic & Inquiry</span>
        </div>
        <div class="step-divider"></div>
        <div class="step-item">
            <div class="step-bubble">4</div>
            <span>Review</span>
        </div>
    </div>

    <!-- Title Header -->
    <div class="text-center mb-5">
        <span class="badge rounded-pill px-3 py-1 text-uppercase font-oracle text-warning mb-2"
              style="background: rgba(255, 209, 102, 0.1); border: 1px solid rgba(255, 209, 102, 0.3);">
            Step 3 · The Sphere of Inquiry
        </span>
        <h2 class="font-decorative gold-gradient-text">CHOOSE YOUR SACRED TOPIC</h2>
        <p class="text-secondary font-oracle max-w-600 mx-auto">
            Focus the celestial energies upon the domain of your life where truth is sought.
        </p>
    </div>

    <!-- Topic Grid (Love, Education, Relationship, General) -->
    <div class="row g-3 mb-4">
        <!-- Love -->
        <div class="col-6 col-md-3">
            <div class="fortune-glass-card p-3 p-md-4 text-center h-100 d-flex flex-column justify-content-between @(SelectedTopic == ReadingTopic.Love ? "border-danger shadow-lg" : "")"
                 style="cursor: pointer;"
                 @onclick="() => SetTopic(ReadingTopic.Love)">
                <div>
                    <div class="fs-1 mb-2" style="color: var(--rose-quartz);">💖</div>
                    <h5 class="font-oracle text-white mb-1">Love</h5>
                    <small class="text-white-50" style="font-size: 0.75rem;">Romance · Soulmates · Desires</small>
                </div>
                <div class="mt-3">
                    <span class="badge @(SelectedTopic == ReadingTopic.Love ? "bg-danger" : "bg-dark text-secondary") font-oracle">
                        @(SelectedTopic == ReadingTopic.Love ? "Selected" : "Select")
                    </span>
                </div>
            </div>
        </div>

        <!-- Education -->
        <div class="col-6 col-md-3">
            <div class="fortune-glass-card p-3 p-md-4 text-center h-100 d-flex flex-column justify-content-between @(SelectedTopic == ReadingTopic.Education ? "border-warning shadow-lg" : "")"
                 style="cursor: pointer;"
                 @onclick="() => SetTopic(ReadingTopic.Education)">
                <div>
                    <div class="fs-1 mb-2" style="color: var(--gold-primary);">📚</div>
                    <h5 class="font-oracle text-white mb-1">Education</h5>
                    <small class="text-white-50" style="font-size: 0.75rem;">Studies · Career · Wisdom</small>
                </div>
                <div class="mt-3">
                    <span class="badge @(SelectedTopic == ReadingTopic.Education ? "bg-warning text-dark" : "bg-dark text-secondary") font-oracle">
                        @(SelectedTopic == ReadingTopic.Education ? "Selected" : "Select")
                    </span>
                </div>
            </div>
        </div>

        <!-- Relationship -->
        <div class="col-6 col-md-3">
            <div class="fortune-glass-card p-3 p-md-4 text-center h-100 d-flex flex-column justify-content-between @(SelectedTopic == ReadingTopic.Relationship ? "border-info shadow-lg" : "")"
                 style="cursor: pointer;"
                 @onclick="() => SetTopic(ReadingTopic.Relationship)">
                <div>
                    <div class="fs-1 mb-2" style="color: var(--astral-cyan);">🤝</div>
                    <h5 class="font-oracle text-white mb-1">Relationship</h5>
                    <small class="text-white-50" style="font-size: 0.75rem;">Friendship · Family · Bonds</small>
                </div>
                <div class="mt-3">
                    <span class="badge @(SelectedTopic == ReadingTopic.Relationship ? "bg-info text-dark" : "bg-dark text-secondary") font-oracle">
                        @(SelectedTopic == ReadingTopic.Relationship ? "Selected" : "Select")
                    </span>
                </div>
            </div>
        </div>

        <!-- General -->
        <div class="col-6 col-md-3">
            <div class="fortune-glass-card p-3 p-md-4 text-center h-100 d-flex flex-column justify-content-between @(SelectedTopic == ReadingTopic.General ? "border-primary shadow-lg" : "")"
                 style="cursor: pointer;"
                 @onclick="() => SetTopic(ReadingTopic.General)">
                <div>
                    <div class="fs-1 mb-2" style="color: var(--amethyst-primary);">🌌</div>
                    <h5 class="font-oracle text-white mb-1">General</h5>
                    <small class="text-white-50" style="font-size: 0.75rem;">Overall Path · Destiny · Karma</small>
                </div>
                <div class="mt-3">
                    <span class="badge @(SelectedTopic == ReadingTopic.General ? "bg-primary" : "bg-dark text-secondary") font-oracle">
                        @(SelectedTopic == ReadingTopic.General ? "Selected" : "Select")
                    </span>
                </div>
            </div>
        </div>
    </div>

    <!-- Optional Question Section -->
    <div class="fortune-glass-card p-4 mb-4">
        <label class="form-label font-oracle text-warning d-flex align-items-center gap-2">
            <i class="bi bi-question-circle"></i> Optional Question or Intention (Optional)
        </label>
        <p class="small text-secondary mb-3">
            Type a specific question you want the AI Reading Service to consult, or leave blank for a general cosmic reading.
        </p>

        <textarea class="form-control bg-black bg-opacity-40 text-light border-secondary p-3 font-oracle"
                  rows="3"
                  placeholder="e.g. What unseen influences surround my upcoming creative venture? Or will our paths realign?"
                  @bind="QuestionText"></textarea>

        <!-- Quick Question Suggestions -->
        <div class="mt-3 d-flex flex-wrap gap-2">
            <span class="small text-secondary me-1 align-self-center">Inspirations:</span>
            <button class="btn btn-sm btn-outline-secondary py-0 px-2 fs-7" @onclick='() => SetPresetQuestion("What is the highest lesson I must integrate right now?")'>
                Highest Lesson
            </button>
            <button class="btn btn-sm btn-outline-secondary py-0 px-2 fs-7" @onclick='() => SetPresetQuestion("What cosmic energy will support my upcoming exam and studies?")'>
                Academic Exam Guidance
            </button>
            <button class="btn btn-sm btn-outline-secondary py-0 px-2 fs-7" @onclick='() => SetPresetQuestion("What truth is blossoming in my current relationship?")'>
                Relationship Truth
            </button>
        </div>
    </div>

    <!-- Actions -->
    <div class="d-flex justify-content-between align-items-center mt-4">
        <button class="btn-cosmic-outline" @onclick="GoBack">
            <i class="bi bi-arrow-left"></i> Back
        </button>
        <button class="btn-cosmic-gold px-4 py-2" @onclick="ProceedToReview">
            REVIEW CHOICES <i class="bi bi-arrow-right"></i>
        </button>
    </div>
</div>

@code {
    private ReadingTopic SelectedTopic = ReadingTopic.General;
    private string? QuestionText;

    protected override void OnInitialized()
    {
        SelectedTopic = State.Topic;
        QuestionText = State.OptionalQuestion;
    }

    private async Task SetTopic(ReadingTopic topic)
    {
        SelectedTopic = topic;
        State.Topic = topic;
        try { await JS.InvokeVoidAsync("fortuneAudio.playCardFlip"); } catch { }
    }

    private void SetPresetQuestion(string text)
    {
        QuestionText = text;
    }

    private void GoBack()
    {
        if (State.ReadingType == ReadingType.Tarot)
        {
            Nav.NavigateTo("tarot-picker");
        }
        else
        {
            Nav.NavigateTo("palm-capture");
        }
    }

    private void ProceedToReview()
    {
        State.Topic = SelectedTopic;
        State.OptionalQuestion = string.IsNullOrWhiteSpace(QuestionText) ? null : QuestionText.Trim();
        Nav.NavigateTo("review-choices");
    }
}
