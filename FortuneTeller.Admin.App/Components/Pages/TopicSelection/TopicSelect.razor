@page "/topic-select"
@inject NavigationManager Nav
@inject FortuneStateService State
@inject IJSRuntime JS

<div class="container py-4 max-w-850 mx-auto">
    <!-- Neumorphic Stepper -->
    <div class="neu-stepper">
        <div class="neu-step-item completed">
            <div class="neu-step-bubble"><i class="bi bi-check2"></i></div>
            <span>Path</span>
        </div>
        <div class="neu-step-divider"></div>
        <div class="neu-step-item completed">
            <div class="neu-step-bubble"><i class="bi bi-check2"></i></div>
            <span>Method</span>
        </div>
        <div class="neu-step-divider"></div>
        <div class="neu-step-item active">
            <div class="neu-step-bubble">3</div>
            <span>Topic & Inquiry</span>
        </div>
        <div class="neu-step-divider"></div>
        <div class="neu-step-item">
            <div class="neu-step-bubble">4</div>
            <span>Review</span>
        </div>
    </div>

    <!-- Title Header -->
    <div class="text-center mb-5">
        <div class="d-inline-flex align-items-center gap-2 px-3 py-1 rounded-pill mb-2 neu-well-sm">
            <span class="text-neu-accent">✦</span>
            <span class="font-display text-neu-muted small text-uppercase fw-bold">Step 3 · Sphere of Inquiry</span>
            <span class="text-neu-accent">✦</span>
        </div>
        <h2 class="font-display fw-extrabold text-neu-primary display-5 mb-1">CHOOSE YOUR TOPIC</h2>
        <p class="font-body text-neu-muted max-w-600 mx-auto">
            Focus the consultation onto the domain of your life seeking clarity.
        </p>
    </div>

    <!-- Topic Grid (Love, Education, Relationship, General) -->
    <div class="row g-3 mb-4">
        <!-- Love -->
        <div class="col-6 col-md-3">
            <div class="p-3 p-md-4 text-center h-100 d-flex flex-column justify-content-between @(SelectedTopic == ReadingTopic.Love ? "neu-well-deep" : "neu-card neu-card-lift")"
                 style="cursor: pointer; border-radius: 24px;"
                 @onclick="() => SetTopic(ReadingTopic.Love)">
                <div>
                    <div class="neu-icon-socket mx-auto mb-3" style="width: 54px; height: 54px; font-size: 1.6rem; color: #f43f5e;">
                        💖
                    </div>
                    <h5 class="font-display fw-bold text-neu-primary mb-1">Love</h5>
                    <small class="font-body text-neu-muted" style="font-size: 0.75rem;">Romance · Desires</small>
                </div>
                <div class="mt-3">
                    <span class="btn-neu-pill small font-display @(SelectedTopic == ReadingTopic.Love ? "active text-neu-accent" : "")">
                        @(SelectedTopic == ReadingTopic.Love ? "Selected" : "Select")
                    </span>
                </div>
            </div>
        </div>

        <!-- Education -->
        <div class="col-6 col-md-3">
            <div class="p-3 p-md-4 text-center h-100 d-flex flex-column justify-content-between @(SelectedTopic == ReadingTopic.Education ? "neu-well-deep" : "neu-card neu-card-lift")"
                 style="cursor: pointer; border-radius: 24px;"
                 @onclick="() => SetTopic(ReadingTopic.Education)">
                <div>
                    <div class="neu-icon-socket mx-auto mb-3" style="width: 54px; height: 54px; font-size: 1.6rem; color: var(--neu-accent);">
                        📚
                    </div>
                    <h5 class="font-display fw-bold text-neu-primary mb-1">Education</h5>
                    <small class="font-body text-neu-muted" style="font-size: 0.75rem;">Studies · Wisdom</small>
                </div>
                <div class="mt-3">
                    <span class="btn-neu-pill small font-display @(SelectedTopic == ReadingTopic.Education ? "active text-neu-accent" : "")">
                        @(SelectedTopic == ReadingTopic.Education ? "Selected" : "Select")
                    </span>
                </div>
            </div>
        </div>

        <!-- Relationship -->
        <div class="col-6 col-md-3">
            <div class="p-3 p-md-4 text-center h-100 d-flex flex-column justify-content-between @(SelectedTopic == ReadingTopic.Relationship ? "neu-well-deep" : "neu-card neu-card-lift")"
                 style="cursor: pointer; border-radius: 24px;"
                 @onclick="() => SetTopic(ReadingTopic.Relationship)">
                <div>
                    <div class="neu-icon-socket mx-auto mb-3" style="width: 54px; height: 54px; font-size: 1.6rem; color: var(--neu-accent-secondary);">
                        🤝
                    </div>
                    <h5 class="font-display fw-bold text-neu-primary mb-1">Bonds</h5>
                    <small class="font-body text-neu-muted" style="font-size: 0.75rem;">Alliances · Harmony</small>
                </div>
                <div class="mt-3">
                    <span class="btn-neu-pill small font-display @(SelectedTopic == ReadingTopic.Relationship ? "active text-neu-accent" : "")">
                        @(SelectedTopic == ReadingTopic.Relationship ? "Selected" : "Select")
                    </span>
                </div>
            </div>
        </div>

        <!-- General -->
        <div class="col-6 col-md-3">
            <div class="p-3 p-md-4 text-center h-100 d-flex flex-column justify-content-between @(SelectedTopic == ReadingTopic.General ? "neu-well-deep" : "neu-card neu-card-lift")"
                 style="cursor: pointer; border-radius: 24px;"
                 @onclick="() => SetTopic(ReadingTopic.General)">
                <div>
                    <div class="neu-icon-socket mx-auto mb-3" style="width: 54px; height: 54px; font-size: 1.6rem; color: var(--neu-foreground);">
                        🌌
                    </div>
                    <h5 class="font-display fw-bold text-neu-primary mb-1">General</h5>
                    <small class="font-body text-neu-muted" style="font-size: 0.75rem;">Destiny · Karma</small>
                </div>
                <div class="mt-3">
                    <span class="btn-neu-pill small font-display @(SelectedTopic == ReadingTopic.General ? "active text-neu-accent" : "")">
                        @(SelectedTopic == ReadingTopic.General ? "Selected" : "Select")
                    </span>
                </div>
            </div>
        </div>
    </div>

    <!-- Optional Question Section -->
    <div class="neu-card p-4 mb-4">
        <label class="form-label font-display fw-bold text-neu-primary d-flex align-items-center gap-2 mb-1">
            <i class="bi bi-question-circle text-neu-accent"></i> Optional Question or Intention
        </label>
        <p class="small font-body text-neu-muted mb-3">
            Enter a specific inquiry for the AI Reading Service, or leave blank for a general prophecy.
        </p>

        <textarea class="neu-textarea"
                  rows="3"
                  placeholder="e.g. What unseen influences surround my upcoming creative venture? Or will our paths realign?"
                  @bind="QuestionText"></textarea>

        <!-- Quick Inspirations -->
        <div class="mt-3 d-flex flex-wrap gap-2 align-items-center">
            <span class="small font-display text-neu-muted me-1">Inspirations:</span>
            <button class="btn-neu-pill font-display" @onclick='() => SetPresetQuestion("What is the highest lesson I must integrate right now?")'>
                Highest Lesson
            </button>
            <button class="btn-neu-pill font-display" @onclick='() => SetPresetQuestion("What energy will support my upcoming exam and studies?")'>
                Exam Guidance
            </button>
            <button class="btn-neu-pill font-display" @onclick='() => SetPresetQuestion("What truth is blossoming in my current relationship?")'>
                Relationship Truth
            </button>
        </div>
    </div>

    <!-- Actions -->
    <div class="d-flex justify-content-between align-items-center mt-4">
        <button class="btn-neu" @onclick="GoBack">
            <i class="bi bi-arrow-left"></i> Back
        </button>
        <button class="btn-neu-primary px-4 py-2" @onclick="ProceedToReview">
            REVIEW CHOICES <i class="bi bi-arrow-right"></i>
        </button>
    </div>
</div>

@code {
    private ReadingTopic SelectedTopic = ReadingTopic.General;
    private string? QuestionText;

    protected override void OnInitialized()
    {
        SelectedTopic = State.Topic;
        QuestionText = State.OptionalQuestion;
    }

    private async Task SetTopic(ReadingTopic topic)
    {
        SelectedTopic = topic;
        State.Topic = topic;
        try { await JS.InvokeVoidAsync("fortuneAudio.playCardFlip"); } catch { }
    }

    private void SetPresetQuestion(string text)
    {
        QuestionText = text;
    }

    private void GoBack()
    {
        if (State.ReadingType == ReadingType.Tarot)
        {
            Nav.NavigateTo("tarot-picker");
        }
        else
        {
            Nav.NavigateTo("palm-capture");
        }
    }

    private void ProceedToReview()
    {
        State.Topic = SelectedTopic;
        State.OptionalQuestion = string.IsNullOrWhiteSpace(QuestionText) ? null : QuestionText.Trim();
        Nav.NavigateTo("review-choices");
    }
}
