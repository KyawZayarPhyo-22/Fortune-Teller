@page "/orchestrator-monitor"
@inject FortuneClientService Client
@inject NavigationManager Nav

<div class="container py-4 max-w-1000 mx-auto">
    <!-- Header -->
    <div class="d-flex flex-wrap justify-content-between align-items-center mb-4">
        <div>
            <span class="badge rounded-pill px-3 py-1 text-uppercase font-oracle text-info mb-2"
                  style="background: rgba(56, 189, 248, 0.1); border: 1px solid rgba(56, 189, 248, 0.3);">
                ✦ Architecture & Diagnostics ✦
            </span>
            <h2 class="font-decorative gold-gradient-text h3 mb-0">READING ORCHESTRATOR MONITOR</h2>
            <small class="text-secondary font-oracle">Real-time WebSocket Gateway & In-Memory Pipeline Telemetry</small>
        </div>
        <div class="d-flex gap-2 mt-3 mt-md-0">
            <button class="btn btn-sm btn-cosmic-purple" @onclick="Refresh">
                <i class="bi bi-arrow-clockwise"></i> Refresh Stats
            </button>
            <a href="choose-reading" class="btn btn-sm btn-cosmic-gold">
                <i class="bi bi-play-fill"></i> Test Reading
            </a>
        </div>
    </div>

    <!-- Quick Telemetry Cards -->
    <div class="row g-3 mb-4">
        <div class="col-md-3 col-6">
            <div class="fortune-glass-card p-3">
                <div class="small text-secondary font-oracle text-uppercase">Total Processed</div>
                <div class="display-6 font-decorative text-warning my-1">@Stats.TotalReadingsProcessed</div>
                <small class="text-white-50">Through Orchestrator</small>
            </div>
        </div>
        <div class="col-md-3 col-6">
            <div class="fortune-glass-card p-3">
                <div class="small text-secondary font-oracle text-uppercase">Tarot vs Palm</div>
                <div class="fs-4 font-oracle text-light my-2">
                    <span class="text-warning">🎴 @Stats.TarotReadingsCount</span> / <span class="text-info">✋ @Stats.PalmReadingsCount</span>
                </div>
                <small class="text-white-50">In-Memory Branch Splits</small>
            </div>
        </div>
        <div class="col-md-3 col-6">
            <div class="fortune-glass-card p-3">
                <div class="small text-secondary font-oracle text-uppercase">Gateway Rate Limits</div>
                <div class="fs-4 font-oracle text-success my-2">
                    @DevCode.RateLimitPerMinute req/min
                </div>
                <small class="text-white-50">Blocked: @Stats.BlockedByRateLimitCount</small>
            </div>
        </div>
        <div class="col-md-3 col-6">
            <div class="fortune-glass-card p-3">
                <div class="small text-secondary font-oracle text-uppercase">Photo Size Limit</div>
                <div class="fs-4 font-oracle text-info my-2">
                    @(DevCode.MaxPhotoSizeBytes / (1024 * 1024)) MB
                </div>
                <small class="text-white-50">Blocked Size: @Stats.BlockedBySizeLimitCount</small>
            </div>
        </div>
    </div>

    <!-- Architectural Pipeline Topology Map (Matching Image 1) -->
    <div class="fortune-glass-card p-4 p-md-5 mb-4">
        <h4 class="font-oracle text-warning mb-4"><i class="bi bi-diagram-3 me-2"></i>Active System Architecture Flow</h4>

        <div class="p-3 rounded-4 bg-black bg-opacity-40 border border-secondary border-opacity-30">
            <div class="d-flex flex-column align-items-center gap-3">
                <!-- User Node -->
                <div class="p-2 px-4 rounded-pill border border-warning text-warning font-oracle small">
                    <i class="bi bi-person-circle me-1"></i> User / Blazor Client (Fortune Teller App)
                </div>

                <i class="bi bi-arrow-down text-secondary"></i>

                <!-- Gateway Node -->
                <div class="p-3 rounded-3 bg-dark border border-secondary text-center max-w-500 w-100 font-oracle small">
                    <div class="text-info fw-bold mb-1"><i class="bi bi-shield-lock me-1"></i> WebSocket Gateway</div>
                    <div class="text-white-50" style="font-size: 0.75rem;">
                        Validate message · Enforce size (&lt; 5MB) · Enforce rate limit (@DevCode.RateLimitPerMinute req/min)
                    </div>
                </div>

                <i class="bi bi-arrow-down text-secondary"></i>

                <!-- Orchestrator Master Node -->
                <div class="p-3 rounded-3 border border-warning bg-black bg-opacity-50 text-center max-w-600 w-100 font-oracle">
                    <div class="text-warning fw-bold fs-5 mb-1"><i class="bi bi-cpu me-1"></i> Reading Orchestrator</div>
                    <div class="text-white-50 small mb-3">Manages in-memory routing, branch processing, and result lifecycle</div>

                    <!-- Branches -->
                    <div class="row g-2 text-start font-oracle" style="font-size: 0.75rem;">
                        <div class="col-6">
                            <div class="p-2 rounded bg-black bg-opacity-60 border border-warning border-opacity-30">
                                <span class="text-warning fw-bold">Branch A: Tarot</span>
                                <div class="text-secondary">Select spread and cards in memory (78 Cards)</div>
                            </div>
                        </div>
                        <div class="col-6">
                            <div class="p-2 rounded bg-black bg-opacity-60 border border-info border-opacity-30">
                                <span class="text-info fw-bold">Branch B: Palm Photo</span>
                                <div class="text-secondary">Analyze image in volatile memory (Lines & Mounts)</div>
                            </div>
                        </div>
                    </div>
                </div>

                <i class="bi bi-arrow-down text-secondary"></i>

                <!-- AI Reading Service -->
                <div class="p-3 rounded-3 bg-dark border border-secondary text-center max-w-500 w-100 font-oracle small">
                    <div class="text-warning fw-bold mb-1"><i class="bi bi-magic me-1"></i> AI Reading Service</div>
                    <div class="text-white-50" style="font-size: 0.75rem;">
                        Synthesizes prophecy for Love · Education · Relationship · General
                    </div>
                </div>

                <i class="bi bi-arrow-down text-secondary"></i>

                <!-- Format and check response -->
                <div class="p-3 rounded-3 bg-dark border border-success text-center max-w-500 w-100 font-oracle small">
                    <div class="text-success fw-bold mb-1"><i class="bi bi-check2-circle me-1"></i> Format and Check Response</div>
                    <div class="text-white-50" style="font-size: 0.75rem;">
                        Seals aura score, assigns lucky number, formats WebSocket result message
                    </div>
                </div>

                <i class="bi bi-arrow-down text-secondary"></i>

                <!-- Return to User -->
                <div class="p-2 px-4 rounded-pill bg-success bg-opacity-20 border border-success text-success font-oracle small">
                    <i class="bi bi-send-check me-1"></i> WebSocket Result Message Delivered to User
                </div>
            </div>
        </div>
    </div>
</div>

@code {
    private OrchestratorStatsModel Stats = new();

    protected override void OnInitialized()
    {
        Refresh();
    }

    private void Refresh()
    {
        Stats = Client.GetStats();
    }
}
