@page "/reading-progress"
@inject NavigationManager Nav
@inject FortuneStateService State
@inject FortuneClientService Client
@inject IJSRuntime JS

<div class="container py-5 max-w-750 mx-auto text-center">
    <div class="neu-card p-4 p-md-5">
        <!-- Header -->
        <div class="mb-4">
            <div class="d-inline-flex align-items-center gap-2 px-3 py-1 rounded-pill mb-3 neu-well-sm">
                <span class="text-neu-accent">✦</span>
                <span class="font-display text-neu-muted small text-uppercase fw-bold">WebSocket Pipeline</span>
                <span class="text-neu-accent">✦</span>
            </div>
            <h2 class="font-display fw-extrabold text-neu-primary display-5 mb-1">COMMUNING WITH DESTINY</h2>
            <p class="font-body text-neu-muted small">
                Transmitting via WebSocket Gateway · Reading Orchestrator In-Memory Execution
            </p>
        </div>

        <!-- Soft UI Divination Spinner -->
        <div class="neu-spinner">
            <div class="neu-spinner-ring">
                @(State.ReadingType == ReadingType.Tarot ? "🎴" : "✋")
            </div>
        </div>

        <!-- Live Percentage -->
        <div class="fs-4 font-display fw-extrabold text-neu-primary mb-2">
            @CurrentPercent% Complete
        </div>

        <!-- Inset Meter Progress Bar -->
        <div class="neu-meter-track max-w-500 mx-auto mb-4">
            <div class="neu-meter-fill" style="width: @CurrentPercent%;"></div>
        </div>

        <!-- Mystical Message Box -->
        <div class="neu-well p-3 max-w-600 mx-auto mb-4 font-display text-neu-primary">
            <i class="bi bi-stars text-neu-accent me-2"></i>
            <span>@CurrentStageMessage</span>
        </div>

        <!-- Live WebSocket Pipeline Steps List -->
        <div class="text-start max-w-500 mx-auto small text-neu-muted font-display">
            <div class="d-flex align-items-center gap-2 mb-2 @(CurrentPercent >= 15 ? "text-neu-accent fw-bold" : "opacity-40")">
                <i class="bi @(CurrentPercent >= 30 ? "bi-check-circle-fill text-neu-teal" : "bi-circle")"></i>
                <span>WebSocket Gateway: Validate message, enforce 5MB & rate limits</span>
            </div>

            <div class="d-flex align-items-center gap-2 mb-2 @(CurrentPercent >= 30 ? "text-neu-accent fw-bold" : "opacity-40")">
                <i class="bi @(CurrentPercent >= 60 ? "bi-check-circle-fill text-neu-teal" : "bi-circle")"></i>
                <span>
                    @(State.ReadingType == ReadingType.Tarot
                        ? "Reading Orchestrator: Select spread and cards in memory"
                        : "Reading Orchestrator: Analyze palm photo in volatile memory")
                </span>
            </div>

            <div class="d-flex align-items-center gap-2 mb-2 @(CurrentPercent >= 60 ? "text-neu-accent fw-bold" : "opacity-40")">
                <i class="bi @(CurrentPercent >= 85 ? "bi-check-circle-fill text-neu-teal" : "bi-circle")"></i>
                <span>AI Reading Service: Generate prophecy for @State.Topic</span>
            </div>

            <div class="d-flex align-items-center gap-2 @(CurrentPercent >= 85 ? "text-neu-accent fw-bold" : "opacity-40")">
                <i class="bi @(CurrentPercent >= 100 ? "bi-check-circle-fill text-neu-teal" : "bi-circle")"></i>
                <span>Format and check response: Seal aura & emit result</span>
            </div>
        </div>

        @if (HasError)
        {
            <div class="neu-well p-3 text-danger font-display small mt-4">
                <i class="bi bi-exclamation-triangle me-2"></i>@ErrorMessage
                <div class="mt-2">
                    <a href="choose-reading" class="btn-neu-pill">Start Over</a>
                </div>
            </div>
        }
    </div>
</div>

@code {
    private int CurrentPercent = 10;
    private string CurrentStageMessage = "Opening WebSocket gateway connection...";
    private bool HasError = false;
    private string? ErrorMessage;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await RunDivinationStream();
        }
    }

    private async Task RunDivinationStream()
    {
        try
        {
            var request = State.BuildRequest();
            var stream = Client.StreamDivinationAsync(request);

            await foreach (var msg in stream)
            {
                CurrentPercent = msg.ProgressPercent;
                CurrentStageMessage = msg.MysticalMessage;

                if (msg.IsError)
                {
                    HasError = true;
                    ErrorMessage = msg.ErrorMessage;
                    StateHasChanged();
                    return;
                }

                if (msg.IsComplete && msg.Result != null)
                {
                    State.CurrentResult = msg.Result;
                    StateHasChanged();

                    try { await JS.InvokeVoidAsync("fortuneAudio.playChime"); } catch { }
                    await Task.Delay(600);
                    Nav.NavigateTo("reading-result");
                    return;
                }

                StateHasChanged();
            }
        }
        catch (Exception ex)
        {
            HasError = true;
            ErrorMessage = $"Oracle communication failed: {ex.Message}";
            StateHasChanged();
        }
    }
}
