@inherits LayoutComponentBase
@implements IDisposable
@using FortuneTeller.Share.Readings
@inject NavigationManager Nav
@inject FortuneStateService State

<div class="neu-app-shell @GetThemeClass()">
    <main class="flex-grow-1 d-flex flex-column">
        @Body
    </main>
</div>

@code {
    protected override void OnInitialized()
    {
        Nav.LocationChanged += OnLocationChanged;
    }

    private void OnLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        InvokeAsync(StateHasChanged);
    }

    private string GetThemeClass()
    {
        var uri = Nav.Uri.ToLowerInvariant();

        // Direct Tarot routes or in-progress Tarot flow
        if (uri.Contains("tarot") || 
            (State.ReadingType == ReadingType.Tarot && (uri.Contains("topic") || uri.Contains("review") || uri.Contains("reading-progress") || uri.Contains("reading-result"))))
        {
            return "bg-tarot-chamber";
        }

        // Direct Palm routes or in-progress Palm flow
        if (uri.Contains("palm") || 
            (State.ReadingType == ReadingType.Palm && (uri.Contains("topic") || uri.Contains("review") || uri.Contains("reading-progress") || uri.Contains("reading-result"))))
        {
            return "bg-palm-chamber";
        }

        // Default: Grand Central Crystal Chamber
        return "bg-fortune-chamber";
    }

    public void Dispose()
    {
        Nav.LocationChanged -= OnLocationChanged;
    }
}
